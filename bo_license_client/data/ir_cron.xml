<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
        <!-- Cron Job: Validar Licencia cada 15 días -->
        <record id="ir_cron_validate_license" model="ir.cron">
            <field name="name">BackOffice: Validar Licencia</field>
            <field name="model_id" ref="model_license_config"/>
            <field name="state">code</field>
            <field name="code">model.cron_validate_license()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active" eval="True"/>
            <field name="doall" eval="False"/>
        </record>
</odoo>